# Скопируй этот файл в .env и заполни значения:
#   cp .env.example .env

# Токен бота от @BotFather (обязательно)
TELEGRAM_TOKEN=

# Твой Telegram chat_id от @userinfobot
# Нужен для авто-уведомлений (бот сам шлёт новые CVE сюда)
TELEGRAM_CHAT_ID=

# Порог CVSS для /scan и авто-уведомлений (по умолчанию 7.0)
CVSS_THRESHOLD=7.0

# Глубина поиска свежих CVE в часах (по умолчанию 24)
HOURS_BACK=24

# Интервал авто-проверки новых CVE в минутах.
# 0 — выключить авто-уведомления (по умолчанию).
# Например 60 — проверять раз в час.
CHECK_INTERVAL_MIN=0

# (необязательно) Ключ NVD API — поднимает лимит с 5 до 50 запросов/30с.
# Получить: https://nvd.nist.gov/developers/request-an-api-key
NVD_API_KEY=
